# Copy to .env and fill in. Never commit .env.

APP_ENV=dev                      # dev | demo | test | production
# DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/copilot.db

# --- Security ------------------------------------------------------------------------
# Fernet key for encrypting sensitive fields at rest. REQUIRED when APP_ENV=production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
SESSION_TTL_MINUTES=240
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
MASK_PII=true                    # mask phones/accounts/NID/TIN before any external LLM call
LOCAL_ONLY_MODE=false            # true = refuse every external LLM; nothing leaves the machine

# --- Sandbox limits (BDT) ------------------------------------------------------------
SANDBOX_PER_TXN_LIMIT=200000
SANDBOX_DAILY_CAP=500000
CONFIRMATION_TTL_MINUTES=10

# --- Demo accounts (seed script). Change these for any shared deployment. --------------
# The four test owners on the login screen (python -m sme_copilot.cli seed --reset).
DEMO_TANVIR_PASSWORD=tanvir-demo-2026
DEMO_SHIRIN_PASSWORD=shirin-demo-2026
DEMO_ROKEYA_PASSWORD=rokeya-demo-2026
DEMO_RAFI_PASSWORD=rafi-demo-2026
# The scripted demo business (seed --reset --story): not listed on the login screen.
DEMO_OWNER_PASSWORD=owner-demo-2026
DEMO_ACCOUNTANT_PASSWORD=accountant-demo-2026
DEMO_VIEWER_PASSWORD=viewer-demo-2026

# --- LLM -----------------------------------------------------------------------------
# One independently running model service for all website users. The browser calls only the website API.
# Start it once with scripts\start_shared_llm.ps1 (reuses Ollama if already running).
LLM_PROFILE=shared-llm
LLM_SHARED_ONLY=true             # prevent users from selecting a different model service
SHARED_LLM_BASE_URL=http://127.0.0.1:11434/v1
SHARED_LLM_MODEL=sme-copilot      # alias of gemma4:12b with a 16k context
# Set LLM_PROFILE=rules-offline for offline use without a model, or LLM_SHARED_ONLY=false to enable switching.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# OLLAMA_BASE_URL=http://localhost:11434/v1   # set automatically in docker-compose

# --- Misc ----------------------------------------------------------------------------
# AS_OF_DATE=2026-10-14        # pin "today" for reproducible demos/benchmarks
DIGEST_SCHEDULER=false         # refresh alerts hourly in the background

# --- Bangladesh shop/trader pilot ----------------------------------------------------
# ALLOW_ILLUSTRATIVE_GUIDANCE=   # unset: illustrative loan matching and generic compliance dates only with APP_ENV=demo
                                 # (the seeded demo business); false = off everywhere. Never true for real owners.
PILOT_SOURCE_CHECKS=false        # enable daily checks in the independent reminder worker
PILOT_QUESTION_MODEL=false       # optional shared local model question selection; rules always work
STRATEGY_QUESTION_MODEL=true     # short, answer-based Strategy follow-ups from the shared local model
PILOT_HELP_CONTACT=              # real facilitator phone or office, shown under Get human help
PILOT_SMS_ENABLED=false          # enable only after commercial onboarding and delivery validation
PILOT_SMS_API_TOKEN=
PILOT_SMS_SID=

# --- Market prices (Home price drawer) -----------------------------------------------
# Public WFP Bangladesh prices from HDX; a bundled snapshot works offline. No business data is sent.
MARKET_PRICES_ENABLED=true
MARKET_REFRESH=true              # weekly background download; skipped when LOCAL_ONLY_MODE=true
MARKET_REFRESH_DAYS=7
# MARKET_DATA_URL=               # override the HDX CSV location
MARKET_FORECAST_MODEL=amazon/chronos-bolt-small   # needs requirements-forecast.txt; empty = statistical estimate

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# --- Goal roadmaps (Strategy) --------------------------------------------------------
# The owner says what they are saving for; the app lays out the months from their own records.
GOAL_ROADMAP_MODEL=true          # let the local model word the roadmap (reviewed wording is the fallback)
# Online price lookup for a goal whose price the owner does not know. The item wording leaves this
# machine only when the owner presses the lookup button; their records never do. Refused outright
# in LOCAL_ONLY_MODE, and off unless an operator turns it on here.
GOAL_PRICE_LOOKUP=false
GOAL_PRICE_SEARCH_URL=https://html.duckduckgo.com/html/?q={query}
