# Copy to .env and fill in. Never commit .env.

APP_ENV=dev                      # dev | demo | test | production
# DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/copilot.db

# --- Security ------------------------------------------------------------------------
# Fernet key for encrypting sensitive fields at rest. REQUIRED when APP_ENV=production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
SESSION_TTL_MINUTES=240
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
MASK_PII=true                    # mask phones/accounts/NID/TIN before any external LLM call
LOCAL_ONLY_MODE=false            # true = refuse every external LLM; nothing leaves the machine

# --- Sandbox limits (BDT) ------------------------------------------------------------
SANDBOX_PER_TXN_LIMIT=200000
SANDBOX_DAILY_CAP=500000
CONFIRMATION_TTL_MINUTES=10

# --- Demo accounts (seed script). Change these for any shared deployment. --------------
DEMO_OWNER_PASSWORD=owner-demo-2026
DEMO_ACCOUNTANT_PASSWORD=accountant-demo-2026
DEMO_VIEWER_PASSWORD=viewer-demo-2026

# --- LLM -----------------------------------------------------------------------------
# The default model is `default_profile` in config/providers.yaml (cloud Claude for the demo).
# Uncomment to override it on this machine, e.g. local-llamacpp (private, needs llama-server running:
# scripts\start_local_llm.bat) or rules-offline (no model at all).
# LLM_PROFILE=local-llamacpp
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# OLLAMA_BASE_URL=http://localhost:11434/v1   # set automatically in docker-compose

# --- Misc ----------------------------------------------------------------------------
# AS_OF_DATE=2026-10-14        # pin "today" for reproducible demos/benchmarks
DIGEST_SCHEDULER=false         # refresh alerts hourly in the background

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
